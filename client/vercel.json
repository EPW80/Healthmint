{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://healthmint-api.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://healthmint-api.onrender.com/health"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
