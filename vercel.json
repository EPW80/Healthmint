{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://healthmint-fdsi.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://healthmint-fdsi.onrender.com/health"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
